# Copy to .env and set the one backend address. It is built into the site by `npm run build`,
# so rebuild after changing it.
#
#   Your PC:           VITE_API_URL=http://localhost:4000/api
#   Deployed:          VITE_API_URL=https://esign.yourcompany.com/api
#   Empty:             calls /api on the site's own address (forwarded to http://localhost:4000 by `npm run dev`)
#
# When the site and the API are on different addresses, also put the site's address in the backend's CORS_ORIGIN.
VITE_API_URL=http://localhost:4000/api
