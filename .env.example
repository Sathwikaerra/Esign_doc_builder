# Copy to .env (development) or .env.production (npm run build) and adjust.
# VITE_* values are built into the site by `npm run build`, so rebuild after changing them.

# Address of the backend API, ending in /api.
#   Leave empty when the site and the API share one address (/api is forwarded to the backend:
#   Vite in development, nginx / IIS / FRONTEND_DIST when deployed).
#   Different addresses: VITE_API_URL=https://api.yourcompany.com/api  (and add the site to CORS_ORIGIN in the backend)
VITE_API_URL=

# Development only: where `npm run dev` forwards /api
VITE_DEV_API_PROXY=http://localhost:4000
